# Origem exata; HTTPS em produção. Nunca use NEXT_PUBLIC para segredos.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Gerados por npm run setup:owner; cookie de 12 horas.
OWNER_PASSWORD_HASH=
SESSION_SECRET=
# local (desenvolvimento), r2 ou vercel-blob (privados em produção)
ROM_STORAGE=local
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=bomberman-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Hash SHA-256 da sua ROM; setup:owner calcula se fornecido caminho.
ROM_SHA256=
# TURN REST / coturn use-auth-secret; credenciais válidas por 1 hora.
STUN_URL=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
# Até 5 pessoas (anfitrião + 4 convidados); adaptador SNES configura Multitap na porta 2.
MAX_PLAYERS=5

# Backend de salas: memory no servidor Node local, redis no deploy Vercel.
ROOM_BACKEND=memory
# Fornecidas pela integração Upstash na Vercel (somente no servidor).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Fornecido pela conexão do Blob privado à Vercel.
BLOB_READ_WRITE_TOKEN=
